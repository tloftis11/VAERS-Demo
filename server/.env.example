# Local dev: SQLite file, zero install required.
# For Render: switch schema.prisma datasource to "postgresql" and set this to
# the Render-provided Postgres connection string.
DATABASE_URL="file:./dev.db"

PORT=4000

# Origin the client is served from (CORS). Vite dev server default shown.
CLIENT_ORIGIN="http://localhost:5173"

# Where uploaded files are stored on local disk.
# NOTE: on Render's standard web services this directory does NOT persist
# across deploys/restarts — see README "Deploying to Render" before relying
# on uploads in production.
UPLOAD_DIR="./uploads"

# Secret used to sign short-lived attachment download tokens.
DOWNLOAD_TOKEN_SECRET="change-me-in-any-real-deployment"

# Shared token gating /admin (vaccine reference-data portal) — prototype-only
# auth. Production would use real federal identity (PIV/CAC or SSO) instead.
ADMIN_TOKEN="change-me-in-any-real-deployment"

# Server-side only — never sent to the browser. Powers the FAQ assistant and
# description-consistency check (see src/services/claudeClient.ts).
ANTHROPIC_API_KEY=""

# Defaults to Claude Opus 5. For this feature's workload (short-context Q&A
# and structured extraction), Claude Haiku 4.5 ("claude-haiku-4-5") is a
# reasonable lower-cost/lower-latency alternative to try — that tradeoff is
# yours to make, so it's just an env var away.
CLAUDE_MODEL="claude-opus-5"
