// Render-only copy of schema.prisma, with the datasource swapped to Postgres.
// Local dev keeps using schema.prisma (SQLite, zero-install) — this file
// exists so deploying doesn't require installing Postgres locally just to
// generate migrations. Render's build runs `prisma db push` against this
// file, which syncs the schema directly without a migrations directory.
// Keep the models below in sync with schema.prisma whenever you change one.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id                   String    @id @default(cuid())
  status               String    @default("draft") // draft | submitted
  submitterType        String? // public | hcp
  administrationError  Boolean? // HCP-only; null = not yet answered
  adverseEventOccurred Boolean? // HCP-only; null = not yet answered (public reports are implicitly true)
  supplementalNotes    String?
  duplicateFlag        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  submittedAt          DateTime?

  submitter       Submitter?
  patient         Patient?
  vaccine         VaccineAdministration?
  adverseEvent    AdverseEvent?
  errorDetail     ErrorDetail?
  attachments     Attachment[]
  surveyResponses SurveyResponse[]
  followUpNotes   FollowUpNote[]
}

model Submitter {
  id              String @id @default(cuid())
  reportId        String @unique
  report          Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  relationship    String?
  mailingAddress  String?
  bestContactInfo String?
}

model Patient {
  id                       String  @id @default(cuid())
  reportId                 String  @unique
  report                   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  firstName                String?
  lastName                 String?
  dateOfBirth              String?
  dateOfBirthUnknown       Boolean @default(false) // when true, ageYears/ageMonths are manually entered instead of derived
  sex                      String?
  ageYears                 Int?
  ageMonths                Int?
  state                    String? // public-path only (PUB-002): patient's state of residence
  pregnant                 String?
  medicationsAtVaccination String?
  allergies                String?
  recentIllnesses          String?
  chronicConditions        String?
  race                     String? // JSON-encoded string array (SQLite has no native array type)
  ethnicity                String?
}

model VaccineAdministration {
  id                    String  @id @default(cuid())
  reportId              String  @unique
  report                Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vaccineType           String?
  vaccineTypeOther      String? // free-text detail when vaccineType is "other"
  manufacturer          String?
  lotNumber             String?
  doseNumber            String?
  administrationDate    String?
  administrationTime    String?
  route                 String?
  bodySite              String?
  administeringFacility String?
  facilityType          String?
  otherVaccinesRecent   String?
  otherVaccinesSameVisit String?
  vaccine2Given         Boolean @default(false)
  vaccine2Type          String?
  vaccine2Manufacturer  String?
  vaccine2LotNumber     String?
  vaccine2Route         String?
  vaccine2BodySite      String?
  vaccine2DoseNumber    String?
}

model AdverseEvent {
  id                          String  @id @default(cuid())
  reportId                    String  @unique
  report                      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  onsetDate                   String?
  onsetTime                   String?
  description                 String?
  symptoms                    String? // JSON-encoded string array (PUB-003: quick-select symptom chips)
  symptomsOther               String? // free-text detail when "Other" is among the selected symptoms
  labResults                  String?
  recoveryStatus              String?
  outcomes                    String? // JSON-encoded string array (SQLite has no native array type)
  hospitalizationDays         Int?
  hospitalName                String?
  hospitalCity                String?
  hospitalState               String?
  dateOfDeath                 String?
  treatmentGiven               String?
  clinicalCourseNotes         String?
  previousAdverseEvent        String?
  previousAdverseEventDetails String?
}

model ErrorDetail {
  id                    String  @id @default(cuid())
  reportId              String  @unique
  report                Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  errorType             String?
  errorDescription      String?
  errorDiscoveredDate   String?
  correctiveActionTaken String?
}

model Attachment {
  id               String   @id @default(cuid())
  reportId         String
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime @default(now())
  // True for documents added via the post-submission Follow-Up Information
  // page (PWS Task 2.1 "maintaining the current upload tool for documents
  // that become available post-submission") rather than during the
  // original report draft.
  isFollowUp       Boolean  @default(false)
}

model FollowUpNote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())
}

model SurveyResponse {
  id        String   @id @default(cuid())
  type      String // navigation | post_submission
  rating    Int
  comment   String?
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
