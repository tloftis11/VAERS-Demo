// Local dev uses SQLite (zero-install). Switch the datasource below to
// "postgresql" + a Render Postgres DATABASE_URL when deploying (see README).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id                   String    @id @default(cuid())
  status               String    @default("draft") // draft | submitted
  submitterType        String? // public | hcp
  reportCharacteristic String? // adverse_event | error_no_ae
  supplementalNotes    String?
  duplicateFlag        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  submittedAt          DateTime?

  submitter       Submitter?
  patient         Patient?
  vaccine         VaccineAdministration?
  adverseEvent    AdverseEvent?
  errorDetail     ErrorDetail?
  attachments     Attachment[]
  surveyResponses SurveyResponse[]
}

model Submitter {
  id           String @id @default(cuid())
  reportId     String @unique
  report       Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contactName  String?
  contactEmail String?
  contactPhone String?
  relationship String?
}

model Patient {
  id                  String  @id @default(cuid())
  reportId            String  @unique
  report              Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  firstName           String?
  lastName             String?
  dateOfBirth         String?
  sex                 String?
  weightKg            Float?
  medicalRecordNumber String?
}

model VaccineAdministration {
  id                    String  @id @default(cuid())
  reportId              String  @unique
  report                Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vaccineType           String?
  manufacturer          String?
  lotNumber             String?
  doseNumber            String?
  administrationDate    String?
  route                 String?
  bodySite              String?
  administeringFacility String?
}

model AdverseEvent {
  id                   String  @id @default(cuid())
  reportId             String  @unique
  report               Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  onsetDate            String?
  description          String?
  outcomes             String? // JSON-encoded string array (SQLite has no native array type)
  hospitalizationDates String?
  treatmentGiven       String?
  clinicalCourseNotes  String?
}

model ErrorDetail {
  id                    String  @id @default(cuid())
  reportId              String  @unique
  report                Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  errorType             String?
  errorDescription      String?
  errorDiscoveredDate   String?
  correctiveActionTaken String?
}

model Attachment {
  id               String   @id @default(cuid())
  reportId         String
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime @default(now())
}

model SurveyResponse {
  id        String   @id @default(cuid())
  type      String // navigation | post_submission
  rating    Int
  comment   String?
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
