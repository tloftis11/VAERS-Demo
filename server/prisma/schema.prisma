// Local dev uses SQLite (zero-install). Switch the datasource below to
// "postgresql" + a Render Postgres DATABASE_URL when deploying (see README).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id                   String    @id @default(cuid())
  status               String    @default("draft") // draft | submitted
  submitterType        String? // public | hcp
  administrationError  Boolean? // HCP-only; null = not yet answered
  adverseEventOccurred Boolean? // HCP-only; null = not yet answered (public reports are implicitly true)
  supplementalNotes    String?
  duplicateFlag        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  submittedAt          DateTime?
  // SHA-256 hex digest of the draft capability token minted at creation —
  // never the raw token itself. See services/draftTokens.ts.
  draftTokenHash       String?

  submitter       Submitter?
  patient         Patient?
  vaccine         VaccineAdministration?
  adverseEvent    AdverseEvent?
  errorDetail     ErrorDetail?
  attachments     Attachment[]
  surveyResponses SurveyResponse[]
  followUpNotes   FollowUpNote[]
}

model Submitter {
  id              String @id @default(cuid())
  reportId        String @unique
  report          Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  relationship    String?
  relationshipOther String? // free-text detail when relationship is "other"
  // Structured mailing-address block, only populated when the reporter opts
  // into a mailed response instead of email (see AboutYouStep.tsx) — most
  // reporters leave these blank, since email is the default.
  mailingStreet   String?
  mailingCity     String?
  mailingState    String?
  mailingZip      String?
  // Item 14 on the real form: name/phone of the best doctor or healthcare
  // professional to contact about the adverse event — split into two
  // fields (not one free-text blob) so a name can't be entered with no way
  // to reach them, or vice versa.
  bestContactName  String?
  bestContactPhone String?
}

model Patient {
  id                       String  @id @default(cuid())
  reportId                 String  @unique
  report                   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  firstName                String?
  lastName                 String?
  dateOfBirth              String?
  dateOfBirthUnknown       Boolean @default(false) // when true, ageYears/ageMonths are manually entered instead of derived
  sex                      String?
  ageYears                 Int?
  ageMonths                Int?
  // PWS item 6's address/contact block — separate from the reporter's own
  // contact/mailing address (Submitter model); staff follow up with the
  // reporter, not the patient directly, so none of this is required.
  street                   String?
  city                     String?
  state                    String? // "foreign" is a valid value here, not just a US code — see STATE_OR_FOREIGN_OPTIONS
  county                   String?
  zip                      String?
  phone                    String?
  email                    String?
  pregnant                 String?
  pregnancyDetails         String?
  medicationsAtVaccination String?
  allergies                String?
  recentIllnesses          String?
  chronicConditions        String?
  race                     String? // JSON-encoded string array (SQLite has no native array type)
  raceOther                String? // free-text detail when "other" is among the selected races
  ethnicity                String?
}

model VaccineAdministration {
  id                    String  @id @default(cuid())
  reportId              String  @unique
  report                Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vaccineType           String?
  vaccineTypeOther      String? // free-text detail when vaccineType is "other"
  manufacturer          String?
  lotNumber             String?
  doseNumber            String?
  administrationDate    String?
  administrationTime    String?
  route                 String?
  bodySite              String?
  administeringFacility String?
  facilityStreet        String?
  facilityCity          String?
  facilityState         String? // "foreign" is a valid value here — see STATE_OR_FOREIGN_OPTIONS
  facilityZip           String?
  facilityPhone         String?
  facilityFax           String?
  facilityType          String?
  facilityTypeOther     String? // free-text detail when facilityType is "other"
  // Public path only (see vaccineSchema in shared/src/schemas.ts) — a
  // single free-text question, kept low-burden for a public reporter.
  otherVaccinesRecent   String?
  otherVaccinesSameVisit String?
  // HCP path only: any number of additional vaccines given at this same
  // visit, and any number of other vaccines the patient received in the
  // month before — each captured as a full bundled row (not gated behind a
  // yes/no + a fixed single extra slot like the prototype's earlier pass).
  additionalVaccines    AdditionalVaccine[]
  priorVaccines         PriorVaccine[]
}

// HCP-only: one row per additional vaccine given at the same visit as the
// primary one above (real VAERS form supports up to 10; here it's however
// many rows the reporter adds).
model AdditionalVaccine {
  id           String                @id @default(cuid())
  vaccineId    String
  vaccine      VaccineAdministration @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  sortOrder    Int                   @default(0)
  vaccineType  String?
  // Detail text when vaccineType is "other"/"foreign" — mirrors
  // VaccineAdministration.vaccineTypeOther for the primary vaccine.
  vaccineTypeOther String?
  manufacturer String?
  lotNumber    String?
  route        String?
  bodySite     String?
  doseNumber   String?
}

// HCP-only: one row per other vaccine the patient received in the month
// before this visit (item 22 on the real paper form is a repeatable table;
// this mirrors that instead of one free-text field).
model PriorVaccine {
  id                 String                @id @default(cuid())
  vaccineId          String
  vaccine            VaccineAdministration @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  sortOrder          Int                   @default(0)
  vaccineName        String?
  administrationDate String?
}

model AdverseEvent {
  id                          String  @id @default(cuid())
  reportId                    String  @unique
  report                      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  onsetDate                   String?
  onsetTime                   String?
  description                 String?
  symptoms                    String? // JSON-encoded string array (PUB-003: quick-select symptom chips)
  symptomsOther               String? // free-text detail when "Other" is among the selected symptoms
  labResults                  String?
  recoveryStatus              String?
  outcomes                    String? // JSON-encoded string array (SQLite has no native array type)
  hospitalizationDays         Int?
  hospitalName                String?
  hospitalCity                String?
  hospitalState               String?
  dateOfDeath                 String?
  treatmentGiven               String?
  clinicalCourseNotes         String?
  previousAdverseEvent        String?
  previousAdverseEventDetails String?
}

model ErrorDetail {
  id                    String  @id @default(cuid())
  reportId              String  @unique
  report                Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  errorType             String?
  errorTypeOther        String? // free-text detail when errorType is "other"
  errorDescription      String?
  errorDiscoveredDate   String?
  correctiveActionTaken String?
}

model Attachment {
  id               String   @id @default(cuid())
  reportId         String
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime @default(now())
  // True for documents added via the post-submission Follow-Up Information
  // page (PWS Task 2.1 "maintaining the current upload tool for documents
  // that become available post-submission") rather than during the
  // original report draft.
  isFollowUp       Boolean  @default(false)
}

model FollowUpNote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())
}

model SurveyResponse {
  id        String   @id @default(cuid())
  type      String // navigation | post_submission
  rating    Int
  comment   String?
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// Admin-managed reference data (see /admin) — replaces the old hardcoded
// VACCINE_TYPES/VACCINE_TYPES_HCP arrays in shared/src/schemas.ts so adding a
// newly-authorized vaccine no longer requires a code deploy. Soft-deleted via
// `active` rather than removed outright, since a past report may reference a
// value that's since been retired.
model VaccineOption {
  id        String   @id @default(cuid())
  value     String
  label     String
  audience  String // public | hcp
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([audience, value])
}
